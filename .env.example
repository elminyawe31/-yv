# ===== ELMINYAWE Media Studio — environment =====

# ---- Admin (hidden panel: click the ELMINYAWE mark in the footer) ----
# Password for the hidden admin panel + history wipe controls.
ADMIN_PASSWORD=change-me

# ---- Durable records on Vercel (v5.4 — Catbox ONLY, zero tokens) ----
# EVERYTHING lives on Catbox: the media FILES (permanent account uploads)
# AND the RECORDS ("the numbers" — history, counters, admin settings) as one
# JSON document indexed by a dedicated album on the same account:
#   https://catbox.moe/c/rcs8x8  (title "ELMINYAWE Records Store")
# The album id is the ONLY stable pointer catbox offers (editalbum replaces
# its whole file list — the official API). No Blob, no tokens, no setup:
# the defaults below are baked in and work on Vercel as-is.
# Override ONLY to point a fork at its own account/album:
# CATBOX_USERHASH=2bb89d603e68f00eb2dc956b5
# ELMINYAWE_RECORDS_ALBUM=rcs8x8
# Self-host escape hatch — force the records store regardless of VERCEL:
# ELMINYAWE_RECORDS_STORE=catbox   (or "sqlite")
# Tip: after deploying, open the hidden admin panel (footer ELMINYAWE mark)
# and press "اختبار التخزين" — it proves BOTH halves live: a real MP3
# roundtrip AND the records album roundtrip, step by step with timings.

# ---- Optional explicit database URL (local dev defaults to db/custom.db) ----
# DATABASE_URL=file:./db/custom.db

# ---- Conversion limits ----
# ONLY limit in the whole system: max output file size (MB). Keeps every
# upload safely under the external storage (Catbox) upload ceiling.
# There is NO storage quota and NO conversion-count limit by design.
MAX_FILE_MB=80
# Concurrent conversions per server instance (1–3).
MAX_CONCURRENT_CONVERSIONS=1
# Overall conversion deadline (ms, ≤ 270000).
CONVERSION_DEADLINE_MS=255000

# ---- Remote media storage ----
# Catbox account userhash (published by the owner in the original source).
CATBOX_USERHASH=2bb89d603e68f00eb2dc956b5

# ---- Framing / embedding ----
# Allowed iframe parents (space-separated origins) for the /e player.
FRAME_ANCESTORS=

# ---- Turnstile solver (Engine 1 unlock) ----
# Owner's ELMINYAWE Solver service that powers Engine 1 (verification bypass).
# The default below is live-tested; to swap a dead instance paste its URL here
# in ANY shape (bare root, with /solve, trailing slashes — auto-detected),
# or change it at runtime from the hidden admin panel (no redeploy needed;
# with a connected Blob store the swap persists across restarts).
# Set to "off" to disable Engine 1 entirely.
# ELMINYAWE_SOLVER_URL=https://turn-production-779f.up.railway.app

# ---- Engine 2 gateway API key (self-healing by default) ----
# The gateway rotates its public key every few weeks; the app scrapes the
# current key from the ytmp3.gl homepage on a 403 and shares it durably.
# Pin your own key here only if you want to freeze it.
# YTMP3GL_API_KEY=

# ---- Bandwidth (Vercel Fast Origin Transfer protection) ----
# Media links /e/… redirect (307) straight to external storage — bytes never
# touch Vercel Compute. Explicit download clicks are proxied ONCE so the
# browser gets the branded filename; set to "1" to redirect those too
# (zero compute bandwidth, filename falls back to the storage key).
# ?proxy=1 on any link still forces the legacy byte-proxy (escape hatch).
# ELMINYAWE_DIRECT_DOWNLOADS=0

# ---- Local binaries (self-host) ----
# YTDLP_PATH=/home/z/.venv/bin/yt-dlp
# FFMPEG_PATH=ffmpeg

# ---- Public base URL for generated links (rarely needed) ----
# PUBLIC_BASE_URL=https://your-domain
